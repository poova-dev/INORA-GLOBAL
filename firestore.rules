// INORA GLOBAL EXIM - Firestore Security Rules
// Paste this configuration into your Firebase Console:
// Firestore Database -> Rules -> Publish

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /enquiries/{doc} {
      // Public site forms can submit lead enquiries
      allow create: if true;
      
      // Reading lead lists, updating status, and deleting requires an authenticated admin session
      allow read, update, delete: if request.auth != null;
    }

    match /products/{doc} {
      // Public site can read products directory
      allow read: if true;
      
      // Product CRUD operations require an authenticated admin session
      allow write: if request.auth != null;
    }
  }
}
